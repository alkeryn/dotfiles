#!/usr/bin/env bash
# Set wallpapers with feh (X11) or hyprpaper >= 0.8 (Wayland).
# Live Hyprland updates use jq; no Python is needed.
set -euo pipefail

usage() {
    printf '%s\n' \
        'Usage: setwall IMAGE {scale,tile,center,fill,max} [--no-xinerama]' \
        '' \
        'X11: runs feh and lets it save ~/.fehbg.' \
        'Wayland: saves hyprpaper.conf and ~/.fehbg without running feh.' \
        'Live Hyprland updates require hyprctl and jq; hyprpaper is started if needed.' \
        'A handwritten hyprpaper.conf is backed up once before replacement.' \
        '' \
        'Wayland modes: scale=fill, tile=tile, center/max=contain, fill=cover.' \
        'Center may scale; --no-xinerama spanning is X11-only.'
}

die() { printf 'setwall: %s\n' "$*" >&2; exit 1; }
usage_error() { printf 'setwall: %s\n' "$*" >&2; usage >&2; exit 2; }

# Atomically replace the target, preserving dotfile symlinks.
temporary_path=
trap 'if [[ -n $temporary_path ]]; then rm -f -- "$temporary_path"; fi' EXIT
atomic_write() {
    local target_path
    IFS= read -r -d '' target_path < <(realpath -mz -- "$1")
    mkdir -p -- "${target_path%/*}"
    temporary_path=$(mktemp -- "${target_path}.XXXXXX")
    cat > "$temporary_path"
    chmod "$2" -- "$temporary_path"
    mv -fT -- "$temporary_path" "$target_path"
    temporary_path=
}

run_hyprctl() {
    local output
    if output=$(timeout 10s hyprctl "$@" 2>&1); then
        printf '%s\n' "$output"
    else
        die "${output:-hyprctl failed or timed out}"
    fi
}

positional=()
no_xinerama=false
while (( $# )); do
    case $1 in
        -h|--help) usage; exit 0 ;;
        --no-xinerama) no_xinerama=true ;;
        --) shift; positional+=("$@"); break ;;
        -*) usage_error "unknown option: $1" ;;
        *) positional+=("$1") ;;
    esac
    shift
done
(( ${#positional[@]} == 2 )) || usage_error 'expected an image path and a mode'
image_path=${positional[0]}
mode=${positional[1]}
case $mode in
    scale) fit_mode=fill ;;
    tile) fit_mode=tile ;;
    center|max) fit_mode=contain ;;
    fill) fit_mode=cover ;;
    *) usage_error "unknown mode: $mode" ;;
esac
case $image_path in
    '~') image_path=$HOME ;;
    '~/'*) image_path=$HOME/${image_path:2} ;;
esac
[[ -f $image_path && -r $image_path ]] || usage_error "image is not a readable file: $image_path"
# NUL-delimited output preserves newlines so the Wayland validation cannot be bypassed.
IFS= read -r -d '' image_path < <(realpath -ez -- "$image_path") || usage_error 'cannot resolve image path'

feh_command=(feh "--bg-$mode")
if "$no_xinerama"; then feh_command+=(--no-xinerama); fi
feh_command+=("$image_path")
# Wayland wins over DISPLAY: Xwayland commonly sets both variables.
if [[ ${XDG_SESSION_TYPE:-} != wayland && -z ${WAYLAND_DISPLAY:-} ]]; then
    [[ ${XDG_SESSION_TYPE:-} == x11 || -n ${DISPLAY:-} ]] || usage_error 'cannot detect an X11 or Wayland session'
    exec "${feh_command[@]}"
fi

# These characters have special meanings in Hyprlang or comma-separated IPC.
if [[ $image_path == *[$'\r\n,#${}']* || $image_path == *[[:space:]] ]]; then
    usage_error 'hyprpaper paths cannot contain newlines, commas, #, $, braces or trailing whitespace'
fi
if [[ $mode == center ]]; then
    printf '%s\n' 'setwall: hyprpaper has no unscaled center mode; using contain' >&2
fi
if "$no_xinerama"; then
    printf '%s\n' 'setwall: hyprpaper cannot span outputs; --no-xinerama is X11-only' >&2
fi

config_path=${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprpaper.conf
config_header='# Generated by setwall; changes are replaced on the next run.'
if [[ -e $config_path ]]; then
    first_line=
    IFS= read -r first_line < "$config_path" || true
    if [[ $first_line != "$config_header" ]]; then
        backup_path=$config_path.bak
        [[ ! -e $backup_path && ! -L $backup_path ]] || die "refusing to overwrite an unmanaged config: $backup_path already exists"
        cp -p -- "$config_path" "$backup_path"
        printf 'setwall: backed up the previous config to %s\n' "$backup_path" >&2
    fi
fi
atomic_write "$config_path" 644 <<EOF
$config_header
splash = false
ipc = true

wallpaper {
    monitor =
    path = $image_path
    fit_mode = $fit_mode
}
EOF

# feh has no save-only mode. Single-quote each argument for a POSIX sh restore
# script, escaping embedded quotes; never execute the command on Wayland.
restore_command=
for argument in "${feh_command[@]}"; do
    restore_command+="'${argument//\'/\'\\\'\'}' "
done
atomic_write "$HOME/.fehbg" 755 <<EOF
#!/bin/sh
# Generated by setwall for the next X11 session.
if [ "\${XDG_SESSION_TYPE:-}" = wayland ] || [ -n "\${WAYLAND_DISPLAY:-}" ]; then
    exit 0
fi
$restore_command
EOF

if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} || -z ${XDG_RUNTIME_DIR:-} ]]; then
    printf '%s\n' 'setwall: saved config; live updates require a Hyprland session' >&2
    exit 0
fi
for command_name in hyprctl jq timeout; do
    command -v "$command_name" >/dev/null || die "config saved, but $command_name is not installed"
done
monitor_names=$(run_hyprctl -j monitors | jq -r '.[] | .name // error("missing monitor name")')
socket_path=$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.hyprpaper.sock
if [[ ! -e $socket_path ]]; then
    # Scope startup to this session. An ordinary IPC failure must not start a
    # duplicate daemon or kill one belonging to another session.
    for command_name in hyprpaper setsid; do
        command -v "$command_name" >/dev/null || die "config saved, but $command_name is not installed"
    done
    state_dir=${XDG_STATE_HOME:-$HOME/.local/state}
    mkdir -p -- "$state_dir"
    log_path=$state_dir/hyprpaper.log
    setsid hyprpaper --config "$config_path" </dev/null >>"$log_path" 2>&1 &
    daemon_pid=$!
    for (( attempt = 0; attempt < 40; attempt++ )); do
        # A new daemon loads the saved config for all monitors.
        [[ ! -e $socket_path ]] || exit 0
        kill -0 "$daemon_pid" 2>/dev/null || break
        sleep 0.05
    done
    die "config saved, but hyprpaper IPC did not become ready; see $log_path"
fi

# Set the fallback for future outputs and override any explicit current targets.
# Hyprpaper 0.8.4 has an upstream live stretch bug; the saved config is correct.
run_hyprctl hyprpaper wallpaper ",$image_path,$fit_mode" >/dev/null
while IFS= read -r monitor; do
    [[ -n $monitor ]] || continue
    run_hyprctl hyprpaper wallpaper "$monitor,$image_path,$fit_mode" >/dev/null
done <<< "$monitor_names"
